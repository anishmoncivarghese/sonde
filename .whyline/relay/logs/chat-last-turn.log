                **({"runner": runner} if runner is not None else {}),
            )
        except AgentUnavailable as error:
            print_fn(str(error))
            continue
        except agents.AgentMissing as error:
            print_fn(str(error))
            continue
        except agents.AgentTimeout as error:
            print_fn(f"{error} -- try again, or /default another agent.")
            continue

