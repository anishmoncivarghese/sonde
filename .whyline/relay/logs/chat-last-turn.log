                    "warn",
                    f"release tasks by {agent}: can't verify that it can push and tag; the first release task will show",
                )
            )

    if roles == config.Roles():
        return checks

    prompt_dir = prompts.prompts_dir(root)
    for name in ("implement.md", "review.md"):
